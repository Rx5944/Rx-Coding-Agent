# Copy to .env (never commit it). Real keys go ONLY here or in your shell environment.
RX_PROVIDER=openrouter            # openrouter | nvidia | openai | ollama | openai-compatible
RX_MODEL=openrouter/free          # use a tool-calling-capable model for real work
OPENROUTER_API_KEY=your-key-here
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1

RX_MODE=ask                       # plan | ask | auto_edit | auto
RX_SANDBOX=auto                   # auto | bwrap | docker | local
# RX_SANDBOX_NETWORK=0            # allow network inside bwrap/docker sandboxes (pip install, npm install)
# RX_ALLOW_UNSANDBOXED_AUTO=0     # let `auto` mode run commands WITHOUT isolation (not recommended)
# RX_CONTEXT_WINDOW=128000
# --- cost / time controls ---
# RX_PRUNE_KEEP_TURNS=6           # compress tool inputs/outputs older than N assistant turns (0 = off)
# RX_MAX_RUN_TOKENS=400000        # stop a run with a report after this many tokens (0 = off)
# RX_MAX_RUN_SECONDS=1800         # active-time budget; time waiting for your approval is NOT counted (0 = off)
# RX_MAX_ITERATIONS=60
# RX_HOME=~/.rx                   # sessions, restore points, server token
# RX_SERVER_TOKEN=                # default: random token stored in $RX_HOME/server_token
# RX_ALLOWED_HOSTS=               # extra Host headers the server accepts (only if you bind beyond loopback)
